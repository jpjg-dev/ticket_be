# Backend local environment example.

# Database
DB_URL=your-database-url
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# Application runtime
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Authentication and external PG
JWT_SECRET=your-jwt-secret-at-least-32-characters
TOSS_SECRET_KEY=your-toss-secret-key

# Cache Redis
CACHE_REDIS_HOST=your-cache-redis-host
CACHE_REDIS_PORT=6379
CACHE_REDIS_CONNECT_TIMEOUT=1s
CACHE_REDIS_TIMEOUT=2s

# Seat distributed lock
SEAT_LOCK_WAIT_TIME=0ms
SEAT_LOCK_WATCHDOG_TIMEOUT=30s
SEAT_LOCK_FALLBACK_MAX_CONCURRENT=2
SEAT_LOCK_FALLBACK_WAIT_TIME=100ms
SEAT_LOCK_RETRY_AFTER_SECONDS=1

# Kafka and Payment Outbox relay
KAFKA_BOOTSTRAP_SERVERS=your-kafka-bootstrap-servers
PAYMENT_OUTBOX_RELAY_ENABLED=true
PAYMENT_OUTBOX_RELAY_FIXED_DELAY=1s
PAYMENT_OUTBOX_RELAY_BATCH_SIZE=20
PAYMENT_OUTBOX_RELAY_LEASE_DURATION=30s
PAYMENT_OUTBOX_RELAY_SEND_TIMEOUT=10s
PAYMENT_OUTBOX_RETRY_INITIAL_DELAY=5s
PAYMENT_OUTBOX_RETRY_MAX_DELAY=5m
PAYMENT_OUTBOX_UNKNOWN_MAX_ATTEMPTS=10
PAYMENT_OUTBOX_TOPIC=ticketledger-payment-events
PAYMENT_OUTBOX_TOPIC_PARTITIONS=3
PAYMENT_OUTBOX_TOPIC_RETENTION=7d
